
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Allure Reports - Generated test artifacts only
/allure-report/
/allure-results/

# heal-locators.mjs scratch report - contains raw local file paths from
# stack traces, must never be committed (see auto-heal.mjs's summary()
# equivalent - this one is deleted by the script itself on every exit path,
# this is just defense-in-depth)
/.heal-locators-report.json
/.heal-locators-report.json.stderr

# Playwright auth storage state - can contain live session cookies/tokens
/.auth/

# macOS
.DS_Store

# Automation state metrics written by scripts/lib/automation-state.mjs -
# foundation data for a future dashboard. Gitignored by default: even though
# the module sanitizes/relativizes paths before writing, treating it as a
# committed-by-default artifact is exactly the pattern that caused the
# leaks earlier in this repo's history. Revisit this once there's an actual
# consumer (dashboard, CI artifact upload) that needs it persisted in git.
/reports/

