{
  "name": "playwrightdemo",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --workers=1 --timeout=120000",
    "test:ui": "playwright test --headed --project=chromium --workers=1 --timeout=120000",
    "test:debug": "playwright test --debug --workers=1 --timeout=120000",
    "test:allure": "rm -rf allure-results allure-report && playwright test --workers=1 --timeout=120000 --reporter=line,allure-playwright && npx allure generate allure-results --clean -o allure-report || true",
    "login-agent": "node ./login-agent.mjs",
    "login-agent:edge": "node ./login-agent.mjs --edge --run",
    "heal": "node ./scripts/auto-heal.mjs",
    "heal:dry-run": "node ./scripts/auto-heal.mjs --dry-run",
    "heal:pr": "node ./scripts/auto-heal.mjs --pr",
    "heal:detect": "node ./scripts/auto-heal.mjs --detect-only",
    "heal-locators": "node ./scripts/heal-locators.mjs",
    "heal-locators:dry-run": "node ./scripts/heal-locators.mjs --dry-run",
    "heal-locators:pr": "node ./scripts/heal-locators.mjs --pr",
    "orchestrate": "node ./graph/automationGraph.mjs",
    "orchestrate:pr": "node ./graph/automationGraph.mjs --pr",
    "orchestrate:diagram": "node ./graph/automationGraph.mjs --diagram"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.13.3",
    "allure-commandline": "^2.31.0",
    "allure-playwright": "^3.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13"
  }
}
